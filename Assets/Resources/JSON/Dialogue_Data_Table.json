{
  "Dialogues": [
    {
      "DialogueID": "DLG_1001",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "정신이 드는가 외지인이여?",
      "NextID": "DLG_1002",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1002",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "폭풍 속에서 그대의 배를 발견했네. 이 섬까지 살아서 흘러온 건 기적에 가깝지.",
      "NextID": "DLG_1003",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1003",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "게다가… 네 몸에서 매우 순수한 정령의 기운이 느껴진다네.",
      "NextID": "DLG_1004",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1004",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "이 섬의 사람이 아닌데도, 정령과 이렇게 동화되는 이는 처음이네.",
      "NextID": "DLG_1005",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1005",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "아마도… 그대는 이 섬이 부른 존재일지도 모르겠군.",
      "NextID": "DLG_1006",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1006",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "부탁이 있다. 마을 근처의 작은 성소가 오염되기 시작했네.",
      "NextID": "DLG_1007",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1007",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "정령들이 날뛰고, 몬스터가 나타나 주민들이 불안에 떨고 있지.",
      "NextID": "DLG_1008",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1008",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "그대의 힘으로 성소를 조사해줄 수 있겠나?",
      "NextID": "",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1031",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "정신이 드는가. 다행이군..",
      "NextID": "DLG_1033",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1033",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "그래, 자네는 패배했네. 그리고 이곳으로 돌아왔지.",
      "NextID": "DLG_1034",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1034",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "그 성소는 단순한 성소가 아니었네.",
      "NextID": "DLG_1035",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1035",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "섬의 균형을 좀먹는 오염의 근원… ‘정화되지 못한 핵’이었지",
      "NextID": "DLG_1037",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1037",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "보통 인간이라면 그 자리에서 정신조차 남기지 못했을 걸세",
      "NextID": "DLG_1038",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1038",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "하지만 자네는 살아 돌아왔고, 기억하고 있지.",
      "NextID": "DLG_1039",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1039",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "섬이 자네를 선택했다는 증거일지도 모르겠군.",
      "NextID": "DLG_1042",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1042",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "그래, 서두르지는 말게.",
      "NextID": "DLG_1043",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1043",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "성소를 정화하기 위해서는 힘뿐만 아니라, 섬의 흐름을 이해해야 하네.",
      "NextID": "DLG_1044",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1044",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "준비가 되면 다시 성소로 향하게 그것이 자네의 첫 번째 정화가 될 테니.",
      "NextID": "DLG_1045",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1045",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "하지만 지금의 힘으로는 부족하네.섬 곳곳을 돌아다니며 스스로를 단련하게.힘과 경험이 쌓이면, 다시 성소가 자네를 부를 걸세.",
      "NextID": "DLG_1046",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2000",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "섬의 기운이 심상치 않네.",
      "NextID": "DLG_2001",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2001",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "원래 이 근처의 고블린들은 사람을 피하며 살아가던 존재들이었지.",
      "NextID": "DLG_2002",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2002",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "하지만 최근 들어 이유 없이 날뛰고 있네.",
      "NextID": "DLG_2003",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2003",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "섬에 무언가 이상이 생겼다는 증거일지도 모르지.",
      "NextID": "DLG_2004",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2004",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "주변의 고블린들을 처치하고, 무슨 일이 벌어지고 있는지 확인해 주겠나?",
      "NextID": "DLG_2005",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2005",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "고블린들의 움직임이 예전과 다르지 않은가?",
      "NextID": "DLG_2006",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2006",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "그들이 난폭해진 이유를 그냥 넘겨서는 안 되네.",
      "NextID": "DLG_2007",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2007",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "기운이 조금 가라앉은 것 같군.",
      "NextID": "DLG_2008",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2008",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "고블린들조차 영향을 받을 만큼, 섬의 균형이 흐트러지고 있다는 뜻이네.",
      "NextID": "DLG_2009",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2009",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "아직 작은 징후일 뿐이지만, 방심할 수는 없겠지.",
      "NextID": "DLG_2010",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2010",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "계속해서 섬을 살피며 이상한 기운의 근원을 찾아야 하네.",
      "NextID": "DLG_2100",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2100",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "고블린들의 이상한 행동은 끝이 아니네.",
      "NextID": "DLG_2101",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2101",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "숲 쪽에서 불길한 기운이 느껴지고 있지.",
      "NextID": "DLG_2102",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2102",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "아직 형체는 보이지 않지만, 섬이 분명 경고하고 있네.",
      "NextID": "DLG_2103",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2103",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "숲을 조사해 보게. 무언가 흔적이 남아 있을 걸세.",
      "NextID": "DLG_2108",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2108",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "...느껴졌네.",
      "NextID": "DLG_2109",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2109",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "숲 깊은 곳에서, 섬의 흐름이 끊긴 지점이 있군.",
      "NextID": "DLG_2110",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2110",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "아직은 작은 균열이지만, 방치하면 커질 걸세.",
      "NextID": "DLG_2111",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2111",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "다음엔 그 근원을 직접 마주하게 될지도 모르겠군.",
      "NextID": "DLG_2112",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2112",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "역시나 예상대로였네.",
      "NextID": "DLG_2113",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2113",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "섬 어딘가에 오염의 근원이 존재하고 있어.",
      "NextID": "DLG_2114",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2114",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "지금은 숲에 남은 흔적만 보였을 뿐이지만…",
      "NextID": "DLG_2115",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2115",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "곧 모습을 드러낼 걸세. 준비를 해야겠군.",
      "NextID": "DLG_2200",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2200",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "숲에서 느껴지던 불안한 기척이, 이제 형태를 갖추기 시작했네.",
      "NextID": "DLG_2201",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2201",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "섬의 흐름을 따라 살아가던 존재가, 오염에 휩쓸린 모양이군.",
      "NextID": "DLG_2202",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2202",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "이 상태로 두면, 주변까지 망가뜨릴 걸세.",
      "NextID": "DLG_2203",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2203",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "그 존재를 멈추게 해 주게. 방법이 무엇이든 말일세.",
      "NextID": "DLG_2209",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2209",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "섬의 흐름이 다시 이어지고 있군.",
      "NextID": "DLG_2210",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2210",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "파괴한 것이 아니라, 멈춘 것에 가깝네.",
      "NextID": "DLG_2211",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2211",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "자네가 처리한 존재 역시 피해자일지도 모르지.",
      "NextID": "DLG_2212",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2212",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "오염은 생명을 가리지 않네.",
      "NextID": "DLG_2213",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2213",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "하지만 이번 일로 확실해졌어.",
      "NextID": "DLG_2214",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2214",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "섬 어딘가에, 이 모든 혼란의 근원이 존재하고 있다는 걸.",
      "NextID": "DLG_2300",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2300",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "...잠깐만.",
      "NextID": "DLG_2301",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2301",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "방금 멈춘 그 존재 너머에서, 더 짙은 기운이 느껴지는군.",
      "NextID": "DLG_2302",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2302",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "이곳이 아니네. 근원은 조금 더 안쪽에 있어.",
      "NextID": "DLG_2305",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2305",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "그래… 이곳이 오염의 핵이네.",
      "NextID": "DLG_2306",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2306",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "형태는 없지만, 분명히 존재하고 있지.",
      "NextID": "DLG_2307",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2307",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "지금 자네가 할 일은 파괴가 아니라—",
      "NextID": "DLG_2308",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2308",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "이 흐름을 끊는 것이네.",
      "NextID": "DLG_2311",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2311",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "흐름이… 안정되고 있군.",
      "NextID": "DLG_2312",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2312",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "완전히 사라진 것은 아니네.",
      "NextID": "DLG_2313",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2313",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "하지만 최소한, 더 퍼지는 건 막아냈어.",
      "NextID": "DLG_2314",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2314",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "이건 시작에 불과하네.",
      "NextID": "DLG_2315",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2315",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "섬 어딘가에, 이 핵을 만들어낸 근원이 따로 존재할 걸세.",
      "NextID": "DLG_2316",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2316",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "이제 자네는, 되돌릴 수 없는 길에 들어섰네.",
      "NextID": "DLG_2400",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2400",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "...성소가 모습을 드러냈군.",
      "NextID": "DLG_2401",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2401",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "저곳이 바로, 섬의 균형이 무너진 시작점이네.",
      "NextID": "DLG_2403",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2403",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "그래. 이제까지와는 차원이 다를 걸세.",
