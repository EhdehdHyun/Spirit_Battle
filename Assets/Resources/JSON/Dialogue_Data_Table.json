      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2404",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "성소 안에는 오염의 핵을 지키는 존재가 기다리고 있지.",
