{
  "Dialogues": [
    {
      "DialogueID": "DLG_1001",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "정신이 드는가 외지인이여?",
      "NextID": "DLG_1002",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1002",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "폭풍 속에서 그대의 배를 발견했네. 이 섬까지 살아서 흘러온 건 기적에 가깝지.",
      "NextID": "DLG_1003",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1003",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "게다가… 네 몸에서 매우 순수한 정령의 기운이 느껴진다네.",
      "NextID": "DLG_1004",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1004",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "이 섬의 사람이 아닌데도, 정령과 이렇게 동화되는 이는 처음이네.",
      "NextID": "DLG_1005",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1005",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "아마도… 그대는 이 섬이 부른 존재일지도 모르겠군.",
      "NextID": "DLG_1006",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1006",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "부탁이 있다. 마을 근처의 작은 성소가 오염되기 시작했네.",
      "NextID": "DLG_1007",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1007",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "정령들이 날뛰고, 몬스터가 나타나 주민들이 불안에 떨고 있지.",
      "NextID": "DLG_1008",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1008",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "그대의 힘으로 성소를 조사해줄 수 있겠나?",
      "NextID": "",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_SHRINE_01",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "음.? 저건 무엇이지?",
      "NextID": "DLG_SHRINE_02",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_SHRINE_02",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "나도 모르는 굉장히 불쾌한 성소가 이런곳에 있다니.. ",
      "NextID": "DLG_SHRINE_03",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_SHRINE_03",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "미안하지만 부탁하나만 하지. 저 불쾌해 보이는 성소좀 조사해줘.",
      "NextID": "",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2000",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "어유~~~!! 요즘 요리에 맛들렸는데, 재료 구하기가 어렵네",
      "NextID": "DLG_2001",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2001",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "너가 그 난파되서 왔다던 그 소녀인가?",
      "NextID": "DLG_2002",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2002",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "흠흠.. 보다시피 내 몸이 이래서, 버섯 3개만 구해줄 수 있겠어?",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2010",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "그런데 말이야… 요즘 숲 근처가 시끄러워졌어.",
      "NextID": "DLG_2011",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2011",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "원래 안 그랬던 늑대들이 더 흉폭해지고 사나워져서 주민들이 모두 겁에 먹었더라고..",
      "NextID":"DLG_2012",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2012",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "미안하지만 나를 도와서 늑대들을 더 처리해줄 수 있겠어?",
      "NextID": null,
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2020",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "흠.. 올 때가 됐는데 왜 안 오지??",
      "NextID": "DLG_2021",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2021",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "안녕 모험가 또 보네~ 그나저나 정말 큰일이야.",
      "NextID": "DLG_2022",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2022",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "요즘 몬스터들이 난폭해져서 무슨일이 생긴건가?",
      "NextID": "DLG_2023",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2023",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "최근에 산으로 가서 사냥을 하겠다던 주민 한명이 돌아오지 않고있어.",
      "NextID": "DLG_2024",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2024",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "그에게 무슨일이 생긴건지 한번 봐야겠는걸. 나 대신 체력물약을 들고 가줄 수 있겠어?",
      "NextID": "DLG_2025",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2025",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "가는길에 몬스터가 있을 수 있으니 몸조심 하고, 이번에도 부탁할게~",
      "NextID": null,
      "IsChoice": false
    }
  ]
}
