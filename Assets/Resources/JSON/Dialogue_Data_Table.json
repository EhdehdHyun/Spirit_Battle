      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2408",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "섬의 첫 번째 시험이, 자네를 기다리고 있네.",
