{
  "Dialogues": [
    {
      "DialogueID": "DLG_1001",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "정신이 드는가 외지인이여?",
      "NextID": "DLG_1002",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1002",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "폭풍 속에서 그대의 배를 발견했네. 이 섬까지 살아서 흘러온 건 기적에 가깝지.",
      "NextID": "DLG_1003",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1003",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "게다가… 네 몸에서 매우 순수한 정령의 기운이 느껴진다네.",
      "NextID": "DLG_1004",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1004",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "이 섬의 사람이 아닌데도, 정령과 이렇게 동화되는 이는 처음이네.",
      "NextID": "DLG_1005",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1005",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "아마도… 그대는 이 섬이 부른 존재일지도 모르겠군.",
      "NextID": "DLG_1006",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1006",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "부탁이 있다. 마을 근처의 작은 성소가 오염되기 시작했네.",
      "NextID": "DLG_1007",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1007",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "정령들이 날뛰고, 몬스터가 나타나 주민들이 불안에 떨고 있지.",
      "NextID": "DLG_1008",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1008",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "그대의 힘으로 성소를 조사해줄 수 있겠나?",
      "NextID": "",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1031",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "정신이 드는가. 다행이군..",
      "NextID": "DLG_1033",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1033",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "그래, 자네는 패배했네. 그리고 이곳으로 돌아왔지.",
      "NextID": "DLG_1034",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1034",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "그 성소는 단순한 성소가 아니었네.",
      "NextID": "DLG_1035",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1035",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "섬의 균형을 좀먹는 오염의 근원… ‘정화되지 못한 핵’이었지",
      "NextID": "DLG_1037",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1037",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "보통 인간이라면 그 자리에서 정신조차 남기지 못했을 걸세",
      "NextID": "DLG_1038",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1038",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "하지만 자네는 살아 돌아왔고, 기억하고 있지.",
      "NextID": "DLG_1039",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1039",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "섬이 자네를 선택했다는 증거일지도 모르겠군.",
      "NextID": "DLG_1042",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1042",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "그래, 서두르지는 말게.",
      "NextID": "DLG_1043",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1043",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "성소를 정화하기 위해서는 힘뿐만 아니라, 섬의 흐름을 이해해야 하네.",
      "NextID": "DLG_1044",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1044",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "준비가 되면 다시 성소로 향하게 그것이 자네의 첫 번째 정화가 될 테니.",
      "NextID": "DLG_1045",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_1045",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "하지만 지금의 힘으로는 부족하네.섬 곳곳을 돌아다니며 스스로를 단련하게.힘과 경험이 쌓이면, 다시 성소가 자네를 부를 걸세.",
      "NextID": "DLG_1046",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2000",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "섬의 기운이 심상치 않네.",
      "NextID": "DLG_2001",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2001",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "원래 이 근처의 고블린들은 사람을 피하며 살아가던 존재들이었지.",
      "NextID": "DLG_2002",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2002",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "하지만 최근 들어 이유 없이 날뛰고 있네.",
      "NextID": "DLG_2003",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2003",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "섬에 무언가 이상이 생겼다는 증거일지도 모르지.",
      "NextID": "DLG_2004",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2004",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "주변의 고블린들을 처치하고, 무슨 일이 벌어지고 있는지 확인해 주겠나?",
      "NextID": "DLG_2005",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2005",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "고블린들의 움직임이 예전과 다르지 않은가?",
      "NextID": "DLG_2006",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2006",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "그들이 난폭해진 이유를 그냥 넘겨서는 안 되네.",
      "NextID": "DLG_2007",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_2007",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "기운이 조금 가라앉은 것 같군.",
      "NextID": "DLG_2008",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_SHRINE_01",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "음.? 저건 무엇이지?",
      "NextID": "DLG_SHRINE_02",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_SHRINE_02",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "나도 모르는 굉장히 불쾌한 성소가 이런곳에 있다니.. ",
      "NextID": "DLG_SHRINE_03",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_SHRINE_03",
      "SpeakerID": "100000",
      "SpeakerName": "정령 수호자",
      "Text": "미안하지만 부탁하나만 하지. 저 불쾌해 보이는 성소좀 조사해줘.",
      "NextID": "",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10000",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "어유~~~!! 요즘 요리에 맛들렸는데, 재료 구하기가 어렵네",
      "NextID": "DLG_10001",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10001",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "너가 그 난파되서 왔다던 그 소녀인가?",
      "NextID": "DLG_10002",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10002",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "흠흠.. 보다시피 내 몸이 이래서, 버섯 3개만 구해줄 수 있겠어?",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10010",
      "SpeakerID": "10003",
      "SpeakerName": "정령",
      "Text": "그런데 말이야… 요즘 숲 근처가 시끄러워졌어.",
      "NextID": "DLG_10011",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10011",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "원래 안 그랬던 늑대들이 더 흉폭해지고 사나워져서 주민들이 모두 겁에 먹었더라고..",
      "NextID":"DLG_10012",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10012",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "미안하지만 나를 도와서 늑대들을 더 처리해줄 수 있겠어?",
      "NextID": null,
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10020",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "흠.. 올 때가 됐는데 왜 안 오지??",
      "NextID": "DLG_10021",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10021",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "안녕 모험가 또 보네~ 그나저나 정말 큰일이야.",
      "NextID": "DLG_10022",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10022",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "요즘 몬스터들이 난폭해져서 무슨일이 생긴건가?",
      "NextID": "DLG_10023",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10023",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "최근에 산으로 가서 사냥을 하겠다던 주민 한명이 돌아오지 않고있어.",
      "NextID": "DLG_10024",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10024",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "그에게 무슨일이 생긴건지 한번 봐야겠는걸. 나 대신 체력물약을 들고 가줄 수 있겠어?",
      "NextID": "DLG_10025",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10025",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "가는길에 몬스터가 있을 수 있으니 몸조심 하고, 이번에도 부탁할게~",
      "NextID": null,
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10030",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "너 덕분에 섬이 다시 평화를 찾고있어.",
      "NextID": "DLG_10031",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10031",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "아직 할 일이 산더미처럼 쌓여 있지만..",
      "NextID": "DLG_10032",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10032",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "다른곳에서도 널 필요로 하는 곳이 많이 있을거야.",
      "NextID": "DLG_10033",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10033",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "너는 특별하니까 어디서든 잘 해낼 수 있을거야.",
      "NextID": "DLG_10034",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10034",
      "SpeakerID": "100003",
      "SpeakerName": "정령",
      "Text": "내가 지도를 더 넓혀줄테니 다른곳도 다 돌아다니면서 모험을 즐겨봐.",
      "NextID": null,
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10050",
      "SpeakerID": "100004",
      "SpeakerName": "사냥꾼",
      "Text": "윽.. 몬스터 때문에 움직이질 못했는데.. 자넨 누구인가? 처음 보는 얼굴이군",
      "NextID": "DLG_2051",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10051",
      "SpeakerID": "100004",
      "SpeakerName": "사냥꾼",
      "Text": "그렇군.. 내가 없는 사이에 자네가 여기에 발을 디뎠구만..",
      "NextID": "DLG_2052",
      "IsChoice": false
    },
    {
      "DialogueID": "DLG_10052",
      "SpeakerID": "100004",
      "SpeakerName": "사냥꾼",
      "Text": "어쨌든 이렇게 나를 위해서 체력 물약을 갖다 주다니, 고마울 따름이야.. 어쨌든 자네 덕분에 몸이 괜찮아 졌으니 얼른 마을로 돌아가야겠어.",
      "NextID": null,
      "IsChoice": false
    }
  ]
}
